<Application x:Class="InventarioAppDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:InventarioAppDesktop.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.Red.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Accent/MaterialDesignColor.LightBlue.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="InventarioPrimaryColor">#1976D2</Color>
            <SolidColorBrush x:Key="InventarioPrimary" Color="{StaticResource InventarioPrimaryColor}"/>
            <SolidColorBrush x:Key="InventarioPrimaryDark" Color="#0D47A1"/>

            <SolidColorBrush x:Key="MaterialDesignBody" Color="#1C1C1E"/>
            <SolidColorBrush x:Key="MaterialDesignBodyLight" Color="#555555"/>
            <SolidColorBrush x:Key="MaterialDesignPaper" Color="#FAFAFA"/>
            <SolidColorBrush x:Key="MaterialDesignDivider" Color="#E0E0E0"/>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
            <local:StringToVisibilityConverter x:Key="StringToVisibility"/>
            <local:IntToVisibilityConverter x:Key="IntToVisibility"/>
            <local:PercentageToWidthConverter x:Key="PercentageToWidth"/>
            <local:PercentageToStarConverter x:Key="PercentageToStar"/>

            <!-- Custom Scroll Thumb Style -->
            <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Scrollbar arrow button base style - hidden -->
            <Style x:Key="ScrollArrowStyle" TargetType="RepeatButton">
                <Setter Property="Width" Value="0"/>
                <Setter Property="Height" Value="0"/>
                <Setter Property="Opacity" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Focusable" Value="False"/>
            </Style>

            <!-- Vertical ScrollBar style - invisible but functional -->
            <Style TargetType="ScrollBar">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                                      Opacity="0" Width="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                                      Opacity="0" Width="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SearchBoxStyle" TargetType="TextBox">
                <Setter Property="Width" Value="350"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Opacity" Value="0.95"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <Border x:Name="border"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                                        BorderThickness="1"
                                        CornerRadius="20"
                                        Background="#FAFAFA"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <md:PackIcon Kind="Magnify" Width="20" Height="20"
                                                     Grid.Column="0"
                                                     VerticalAlignment="Center"
                                                      Margin="14,0,0,0"
                                                      Foreground="#999999"/>
                                        <Grid Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="Buscar" FontSize="14"
                                                       Foreground="#999999"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"
                                                       Margin="4,0,0,0"
                                                       Visibility="{Binding Text.Length, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource IntToVisibility}}"/>
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                          VerticalAlignment="Center"
                                                          Margin="4,0,12,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource InventarioPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource InventarioPrimary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
