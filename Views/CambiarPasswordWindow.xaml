<Window x:Class="InventarioAppDesktop.Views.CambiarPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="" Height="420" Width="460"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/InventarioApp.ico"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        ShowInTaskbar="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF9800"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E65100"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#EF6C00">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleBarButtonStyle}" Click="Close_Click">
                    <md:PackIcon Kind="Close" Width="14" Height="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="36,0">
            <md:PackIcon Kind="ShieldKey" Width="48" Height="48" Foreground="{StaticResource InventarioPrimary}"
                         HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock Text="Cambio de contraseña requerido" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource MaterialDesignBody}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="Por seguridad, debe establecer una nueva contraseña antes de continuar."
                       FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>

            <TextBlock Text="Nueva contraseña" FontSize="13" Margin="0,0,0,4"
                       Foreground="{DynamicResource MaterialDesignBody}"/>
            <PasswordBox x:Name="TxtNueva" md:HintAssist.Hint="Mínimo 8 caracteres"
                         Padding="12,10" FontSize="14" Margin="0,0,0,14"/>

            <TextBlock Text="Confirmar contraseña" FontSize="13" Margin="0,0,0,4"
                       Foreground="{DynamicResource MaterialDesignBody}"/>
            <PasswordBox x:Name="TxtConfirmar" md:HintAssist.Hint="Repita su contraseña"
                         Padding="12,10" FontSize="14" Margin="0,0,0,18"/>

            <TextBlock x:Name="LblError" Foreground="#DC3545" FontSize="12" TextWrapping="Wrap"
                       Margin="0,0,0,14"/>

            <Button Click="BtnGuardar_Click"
                    Background="{StaticResource InventarioPrimary}"
                    Foreground="White" FontSize="14" FontWeight="Bold"
                    MinHeight="44" Padding="0,10"
                    HorizontalAlignment="Stretch">
                <TextBlock Text="Guardar y continuar" Foreground="White"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
