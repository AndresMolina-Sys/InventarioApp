<Window x:Class="InventarioAppDesktop.Views.ArticuloDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Titulo}" Height="640" Width="520"
        MinHeight="600" MinWidth="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <md:Card Padding="32,28" Margin="16">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <md:PackIcon Kind="Box" Width="28" Height="28" Foreground="{StaticResource InventarioPrimary}"
                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="LblTitulo" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBox x:Name="TxtCodigo" md:HintAssist.Hint="Código del artículo"
                     md:TextFieldAssist.HasOutlinedTextField="True"
                     Margin="0,0,0,16"/>
            <TextBox x:Name="TxtNombre" md:HintAssist.Hint="Nombre del artículo"
                     md:TextFieldAssist.HasOutlinedTextField="True"
                     Margin="0,0,0,16"/>
            <TextBox x:Name="TxtSku" md:HintAssist.Hint="Nº de serie (opcional)"
                     md:TextFieldAssist.HasOutlinedTextField="True"
                     Margin="0,0,0,16"/>
            <TextBox x:Name="TxtDepartamento" md:HintAssist.Hint="Ubicación"
                     md:TextFieldAssist.HasOutlinedTextField="True"
                     Margin="0,0,0,16"/>
            <TextBox x:Name="TxtMarca" md:HintAssist.Hint="Marca (opcional)"
                     md:TextFieldAssist.HasOutlinedTextField="True"
                     Margin="0,0,0,16"/>
            <TextBox x:Name="TxtModelo" md:HintAssist.Hint="Modelo (opcional)"
                     md:TextFieldAssist.HasOutlinedTextField="True"
                     Margin="0,0,0,16"/>
            <TextBox x:Name="TxtPrecio" md:HintAssist.Hint="Costo $ (opcional)"
                     md:TextFieldAssist.HasOutlinedTextField="True"
                     Margin="0,0,0,16"/>
            <TextBox x:Name="TxtNotas" md:HintAssist.Hint="Notas (opcional)"
                     md:TextFieldAssist.HasOutlinedTextField="True"
                     TextWrapping="Wrap" AcceptsReturn="True" MinLines="2" MaxLines="4"
                     Margin="0,0,0,20"/>

            <TextBlock x:Name="LblError" Foreground="#DC3545" FontSize="12" Margin="0,0,0,16"
                       TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource MaterialDesignFlatButton}"
                        Click="BtnCancelar_Click" Margin="0,0,8,0"/>
                <Button Content="GUARDAR" Click="BtnGuardar_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{StaticResource InventarioPrimary}" Foreground="White"
                        Padding="20,8"/>
            </StackPanel>
        </StackPanel>
    </md:Card>
</Window>
