<UserControl x:Class="InventarioAppDesktop.Views.ArticulosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel LastChildFill="True" Margin="32,24,32,24">

        <!-- Articles Table (Main View) -->
        <StackPanel x:Name="PanelArticulos" DockPanel.Dock="Top">
            <TextBlock Text="Artículos" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBox Style="{StaticResource SearchBoxStyle}"
                         md:HintAssist.Hint="Buscar artículo..."
                         Text="{Binding ArticulosVM.Filtro, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Margin="16,0,0,0"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Padding="12,8" MinHeight="36" Cursor="Hand"
                        Click="BtnRefrescar_Click"
                        ToolTip="Refrescar: ver los cambios realizados desde otras PCs">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,6,0"/>
                        <TextBlock Text="REFRESCAR" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Margin="16,0,0,0"
                        Background="{StaticResource InventarioPrimary}"
                        Foreground="White" MinHeight="36" Padding="16,8"
                        Click="BtnNuevoArticulo_Click"
                        Visibility="{Binding EsAdmin, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,6,0"/>
                        <TextBlock Text="NUEVO ARTÍCULO" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <md:Card Padding="0">
                <DataGrid x:Name="GridArticulos" ItemsSource="{Binding ArticulosVM.Articulos}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="None" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="#F8F8F8"
                          HeadersVisibility="Column" SelectionMode="Single"
                          ColumnHeaderHeight="44" RowHeight="44"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="False"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="False"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                    <TextBlock Text="Nombre" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="LblSortNombreArt" Text="v" FontWeight="Bold" FontSize="12"
                                               Cursor="Hand" Background="Transparent"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               MouseLeftButtonDown="BtnSortNombreArt_Click"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                    <TextBlock Text="Categoría" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="LblSortCategoriaArt" Text="v" FontWeight="Bold" FontSize="12"
                                               Cursor="Hand" Background="Transparent"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               MouseLeftButtonDown="BtnSortCategoriaArt_Click"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Categoria.Nombre}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                    <TextBlock Text="Fecha de Ingreso" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="LblSortFechaIngreso" Text="v" FontWeight="Bold" FontSize="12"
                                               Cursor="Hand" Background="Transparent"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               MouseLeftButtonDown="BtnSortFechaIngreso_Click"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FechaIngreso, StringFormat='{}{0:dd/MM/yyyy hh:mm tt}'}"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="ColAcciones" Width="124">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Acciones" FontWeight="Bold" FontSize="13"
                                           HorizontalAlignment="Center"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Click="BtnVerArticulo_Click" Tag="{Binding}" Padding="6">
                                            <md:PackIcon Kind="Eye" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Click="BtnEditarArticulo_Click" Tag="{Binding}" Padding="6"
                                                Visibility="{Binding DataContext.EsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                            <md:PackIcon Kind="Pencil" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Click="BtnEliminarArticulo_Click" Tag="{Binding}" Padding="6"
                                                Foreground="#DC3545"
                                                Visibility="{Binding DataContext.EsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                            <md:PackIcon Kind="Delete" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="44"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>
            </md:Card>

            <!-- Pagination -->
            <StackPanel x:Name="PanelPaginacion" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,16,0,0" VerticalAlignment="Center">
                <Button Command="{Binding ArticulosVM.PaginaAnteriorCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Padding="10,6"
                        IsEnabled="{Binding ArticulosVM.PuedeRetroceder}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ChevronLeft" Width="20" Height="20" Margin="0,0,4,0"/>
                        <TextBlock Text="Anterior" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding ArticulosVM.TextoPagina}" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="24,0"/>
                <Button Command="{Binding ArticulosVM.PaginaSiguienteCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Padding="10,6"
                        IsEnabled="{Binding ArticulosVM.PuedeAvanzar}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Siguiente" VerticalAlignment="Center"/>
                        <md:PackIcon Kind="ChevronRight" Width="20" Height="20" Margin="4,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel x:Name="LblNoArticulos" Visibility="Collapsed" Margin="0,32,0,0"
                        HorizontalAlignment="Center">
                <md:PackIcon Kind="PackageVariantClosed" Width="48" Height="48"
                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                             HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="No hay artículos registrados" FontSize="16"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Article Detail (Ficha Técnica) -->
        <StackPanel x:Name="PanelFichaTecnica" DockPanel.Dock="Top" Visibility="Collapsed"
                    MaxWidth="520" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <TextBlock Text="Ficha Técnica" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Click="BtnVolverFicha_Click"
                        HorizontalAlignment="Right" Padding="12,6" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ArrowLeft" Width="20" Height="20" Margin="0,0,6,0"/>
                        <TextBlock Text="Volver"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <md:Card Padding="28,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Código:" FontSize="13" Width="160" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaCodigo" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Nombre:" FontSize="13" Width="160" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaNombre" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Marca:" FontSize="13" Width="160" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaMarca" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Modelo:" FontSize="13" Width="160" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaModelo" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Nº de Serie:" FontSize="13" Width="160" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaSku" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Categoría:" FontSize="13" Width="160" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaCategoria" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Ubicación:" FontSize="13" Width="160" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaUbicacion" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Fecha de Ingreso:" FontSize="13" Width="160" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaFecha" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Última Modificación:" FontSize="13" Width="160" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaModificacion" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Costo:" FontSize="13" Width="160" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaPrecio" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <TextBlock Text="Notas:" FontSize="13" Width="160" VerticalAlignment="Top"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaNotas" FontSize="15" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="300" Margin="0,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </md:Card>
        </StackPanel>

        <!-- New/Edit Article Form View -->
        <StackPanel x:Name="PanelNuevoArticulo" DockPanel.Dock="Top" Visibility="Collapsed"
                    MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock x:Name="LblFormTitle" Text="Nuevo Artículo" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>

            <md:Card Padding="28,24">
                <StackPanel>
                    <TextBlock Text="Código" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBox x:Name="TxtCodigo" Padding="12,10" FontSize="14" Margin="0,0,0,16"/>

                    <TextBlock Text="Nombre" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBox x:Name="TxtNombre" Padding="12,10" FontSize="14" Margin="0,0,0,16"/>

                    <TextBlock Text="Marca (opcional)" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBox x:Name="TxtMarca" Padding="12,10" FontSize="14" Margin="0,0,0,16"/>

                    <TextBlock Text="Modelo (opcional)" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBox x:Name="TxtModelo" Padding="12,10" FontSize="14" Margin="0,0,0,16"/>

                    <TextBlock Text="Nº de Serie (opcional)" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBox x:Name="TxtSku" Padding="12,10" FontSize="14" Margin="0,0,0,16"/>

                    <TextBlock Text="Ubicación" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBox x:Name="TxtDepartamento" Padding="12,10" FontSize="14" Margin="0,0,0,16"/>

                    <TextBlock Text="Categoría" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <ComboBox x:Name="CmbCategoria" Padding="10,8" FontSize="14"
                              Margin="0,0,0,16" DisplayMemberPath="Nombre"/>

                    <TextBlock Text="Costo $ (opcional)" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBox x:Name="TxtPrecio" Padding="12,10" FontSize="14" Margin="0,0,0,16"/>

                    <TextBlock Text="Notas (opcional)" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBox x:Name="TxtNotas" Padding="12,10" FontSize="14" Margin="0,0,0,20"
                             TextWrapping="Wrap" AcceptsReturn="True" MinLines="2" MaxLines="4"/>

                    <TextBlock x:Name="LblFormError" Foreground="#DC3545" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="BtnCancelarNuevoArticulo_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Margin="0,0,8,0" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ArrowLeft" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnGuardarNuevoArticulo_Click"
                                Background="{StaticResource InventarioPrimary}"
                                Foreground="White" Padding="20,8" MinHeight="36">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Check" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Guardar" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </md:Card>
        </StackPanel>
    </DockPanel>
</UserControl>
