<UserControl x:Class="InventarioAppDesktop.Views.CategoriasPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel LastChildFill="True" Margin="32,24,32,24">

        <!-- List View -->
        <StackPanel x:Name="PanelLista" DockPanel.Dock="Top">
            <TextBlock Text="Categorías" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBox Style="{StaticResource SearchBoxStyle}"
                         md:HintAssist.Hint="Buscar categoría..."
                         Text="{Binding CategoriasVM.Filtro, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Margin="16,0,0,0"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Padding="12,8" MinHeight="36" Cursor="Hand"
                        Click="BtnRefrescar_Click"
                        ToolTip="Refrescar: ver los cambios realizados desde otras PCs">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,6,0"/>
                        <TextBlock Text="REFRESCAR" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Margin="16,0,0,0"
                        Click="BtnNueva_Click"
                        Background="{StaticResource InventarioPrimary}"
                        Foreground="White" MinHeight="36" Padding="16,8"
                        Visibility="{Binding EsAdmin, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,6,0"/>
                        <TextBlock Text="NUEVA CATEGORÍA" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CategoriasVM.Categorias}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <md:Card Padding="20,16" Margin="0,0,12,12" Width="280" MinHeight="120">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <md:PackIcon Kind="Tag" Width="22" Height="22"
                                                     Foreground="{StaticResource InventarioPrimary}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Nombre}" FontSize="16" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <Border Background="{StaticResource InventarioPrimary}"
                                                CornerRadius="12" Padding="10,4">
                                            <TextBlock FontSize="13" Foreground="White" FontWeight="SemiBold"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding CantidadArticulos, Mode=OneWay}"/>
                                                <Run Text=" artículos"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Tag="{Binding}" Click="BtnVerDetalle_Click" Padding="8,4" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="Eye" Width="16" Height="16" Margin="0,0,4,0"
                                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                <TextBlock Text="Ver" FontSize="12"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Tag="{Binding}" Click="BtnEditar_Click" Padding="8,4" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0"
                                                Visibility="{Binding DataContext.EsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="Pencil" Width="16" Height="16" Margin="0,0,4,0"
                                                             Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                <TextBlock Text="Editar" FontSize="12"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Tag="{Binding}" Click="BtnEliminar_Click" Padding="8,4" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0"
                                                Visibility="{Binding DataContext.EsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="Delete" Width="16" Height="16" Margin="0,0,4,0"
                                                             Foreground="#DC3545"/>
                                                <TextBlock Text="Eliminar" FontSize="12"
                                                           Foreground="#DC3545"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </md:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <!-- Detalles de Categoría View -->
        <StackPanel x:Name="PanelDetalles" DockPanel.Dock="Top" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <TextBlock x:Name="LblDetallesNombre" FontSize="28" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock x:Name="LblDetallesConteo" FontSize="14"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Click="BtnVolverDetalles_Click"
                        HorizontalAlignment="Right" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ArrowLeft" Width="20" Height="20" Margin="0,0,6,0"/>
                        <TextBlock Text="Volver"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBox Style="{StaticResource SearchBoxStyle}"
                     md:HintAssist.Hint="Buscar artículo..."
                     Margin="0,0,0,16"
                     Text="{Binding ArticulosVM.Filtro, UpdateSourceTrigger=PropertyChanged}"/>

            <md:Card Padding="0">
                <DataGrid x:Name="GridDetallesArticulos" ItemsSource="{Binding ArticulosVM.Articulos}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="None" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="#F8F8F8"
                          HeadersVisibility="Column" SelectionMode="Single"
                          ColumnHeaderHeight="44" RowHeight="44">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                    <TextBlock Text="Código" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="LblSortDetCodigo" Text="v" FontWeight="Bold" FontSize="12"
                                               Cursor="Hand" Background="Transparent"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               MouseLeftButtonDown="BtnSortDetCodigo_Click"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Codigo}" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                    <TextBlock Text="Nombre" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="LblSortDetNombre" Text="v" FontWeight="Bold" FontSize="12"
                                               Cursor="Hand" Background="Transparent"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               MouseLeftButtonDown="BtnSortDetNombre_Click"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                    <TextBlock Text="Nº de Serie" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="LblSortDetSku" Text="v" FontWeight="Bold" FontSize="12"
                                               Cursor="Hand" Background="Transparent"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               MouseLeftButtonDown="BtnSortDetSku_Click"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{DynamicResource MaterialDesignBodyLight}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Sku}" Value="">
                                                        <Setter Property="Text" Value="N/A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Sku}" Value="{x:Null}">
                                                        <Setter Property="Text" Value="N/A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="Text" Value="{Binding Sku}"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                    <TextBlock Text="Ubicación" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="LblSortDetUbicacion" Text="v" FontWeight="Bold" FontSize="12"
                                               Cursor="Hand" Background="Transparent"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               MouseLeftButtonDown="BtnSortDetUbicacion_Click"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Departamento}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                    <TextBlock Text="Última Modificación" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="LblSortDetFecha" Text="v" FontWeight="Bold" FontSize="12"
                                               Cursor="Hand" Background="Transparent"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               MouseLeftButtonDown="BtnSortDetFecha_Click"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FechaModificacion, StringFormat='{}{0:dd/MM/yyyy hh:mm tt}'}"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="ColDetallesAcciones" Width="120">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Acciones" FontWeight="Bold" FontSize="13"
                                           HorizontalAlignment="Center"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Click="BtnVerDetalleArticulo_Click" Tag="{Binding}" Padding="6">
                                            <md:PackIcon Kind="Eye" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Click="BtnEliminarDetalleArticulo_Click" Tag="{Binding}" Padding="6"
                                                Foreground="#DC3545"
                                                Visibility="{Binding DataContext.EsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                            <md:PackIcon Kind="Delete" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>
            </md:Card>

            <StackPanel x:Name="LblNoDetallesArticulos" Visibility="Collapsed" Margin="0,32,0,0"
                        HorizontalAlignment="Center">
                <md:PackIcon Kind="PackageVariantClosed" Width="48" Height="48"
                             Foreground="{DynamicResource MaterialDesignBodyLight}"
                             HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="No hay artículos en esta categoría" FontSize="16"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Article Ficha Tecnica from Detalles -->
        <StackPanel x:Name="PanelFichaArticulo" DockPanel.Dock="Top" Visibility="Collapsed"
                    MaxWidth="520" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <TextBlock Text="Ficha Técnica" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Click="BtnVolverFichaArticulo_Click"
                        HorizontalAlignment="Right" Padding="12,6" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ArrowLeft" Width="20" Height="20" Margin="0,0,6,0"/>
                        <TextBlock Text="Volver"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <md:Card Padding="28,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Código:" FontSize="13" Width="140" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaCodigo" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Nombre:" FontSize="13" Width="140" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaNombre" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Marca:" FontSize="13" Width="140" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaMarca" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Modelo:" FontSize="13" Width="140" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaModelo" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Nº de Serie:" FontSize="13" Width="140" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaSku" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Categoría:" FontSize="13" Width="140" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaCategoria" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Ubicación:" FontSize="13" Width="140" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaUbicacion" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Fecha de Ingreso:" FontSize="13" Width="140" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaFechaIngreso" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Última Modificación:" FontSize="13" Width="140" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaFecha" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Costo:" FontSize="13" Width="140" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaPrecio" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <TextBlock Text="Notas:" FontSize="13" Width="140" VerticalAlignment="Top"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                        <TextBlock x:Name="LblFichaNotas" FontSize="15" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="300" Margin="0,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </md:Card>
        </StackPanel>

        <!-- Edit View -->
        <StackPanel x:Name="PanelEditar" DockPanel.Dock="Top" Visibility="Collapsed"
                    MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Text="Editar Categoría" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>

            <md:Card Padding="28,24">
                <StackPanel>
                    <TextBlock Text="Nombre" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBox x:Name="TxtNombreEditar" Padding="12,10" FontSize="14" Margin="0,0,0,16"/>

                    <TextBlock x:Name="LblErrorEditar" Foreground="#DC3545" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="BtnCancelarEditar_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Margin="0,0,8,0" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ArrowLeft" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnGuardarEditar_Click"
                                Background="{StaticResource InventarioPrimary}"
                                Foreground="White" Padding="20,8" MinHeight="36">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Check" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Actualizar" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </md:Card>
        </StackPanel>

        <!-- New View -->
        <StackPanel x:Name="PanelNueva" DockPanel.Dock="Top" Visibility="Collapsed"
                    MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Text="Nueva Categoría" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>

            <md:Card Padding="28,24">
                <StackPanel>
                    <TextBlock Text="Nombre" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBox x:Name="TxtNombreNueva" Padding="12,10" FontSize="14" Margin="0,0,0,16"/>

                    <TextBlock x:Name="LblErrorNueva" Foreground="#DC3545" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="BtnCancelarNueva_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Margin="0,0,8,0" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ArrowLeft" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnGuardarNueva_Click"
                                Background="{StaticResource InventarioPrimary}"
                                Foreground="White" Padding="20,8" MinHeight="36">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Check" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Guardar" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </md:Card>
        </StackPanel>
    </DockPanel>
</UserControl>
