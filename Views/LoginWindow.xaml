<Window x:Class="InventarioAppDesktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:InventarioAppDesktop.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="" Height="700" Width="480"
        MinHeight="480" MinWidth="380"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/InventarioApp.ico"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto">

        <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" GlassFrameThickness="0" ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#42A5F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar (solo botones) -->
        <Grid Grid.Row="0" Background="#1976D2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}" Click="Minimize_Click">
                    <md:PackIcon Kind="WindowMinimize" Width="14" Height="14"/>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButtonStyle}" Click="Maximize_Click">
                    <md:PackIcon Kind="WindowMaximize" Width="14" Height="14"/>
                </Button>
                <Button Style="{StaticResource TitleBarButtonStyle}" Click="Close_Click" Background="#1976D2">
                    <md:PackIcon Kind="Close" Width="14" Height="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="300" MaxWidth="380">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Grid.Row="0" Source="pack://application:,,,/Resources/InventarioAppLogo.png"
               Height="100" HorizontalAlignment="Center" Margin="0,0,0,16"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- Login Panel -->
        <md:Card Grid.Row="1" Padding="24" x:Name="CardLogin">
            <StackPanel>
                <TextBlock Text="Iniciar Sesión" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource MaterialDesignBody}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Demo local · tus datos se guardan en este equipo" FontSize="12"
                           Foreground="#888888" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <TextBlock Text="Usuario" FontSize="13" Margin="0,0,0,4"
                           Foreground="{DynamicResource MaterialDesignBody}"/>
                <Grid Margin="0,0,0,16">
                    <TextBox x:Name="TxtUsuario"
                             Padding="12,10" FontSize="14"
                             Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Ingrese su usuario"/>
                    <TextBlock Text="Ingrese su usuario" Padding="12,11" FontSize="14"
                               Foreground="#999999" IsHitTestVisible="False"
                               Visibility="{Binding ElementName=TxtUsuario, Path=Text.Length, Converter={StaticResource IntToVisibility}}"/>
                </Grid>

                <TextBlock Text="Contraseña" FontSize="13" Margin="0,0,0,4"
                           Foreground="{DynamicResource MaterialDesignBody}"/>
                <PasswordBox x:Name="TxtPassword" md:HintAssist.Hint="Ingrese su contraseña"
                             Padding="12,10" FontSize="14" Margin="0,0,0,20"/>

                <TextBlock x:Name="LblError" Text="{Binding MensajeError}"
                           Foreground="#DC3545" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"
                           Visibility="{Binding MensajeError, Converter={StaticResource StringToVisibility}}"/>

                <Button Click="BtnLogin_Click"
                        Background="{StaticResource InventarioPrimary}"
                        Foreground="White" FontSize="14" FontWeight="Bold"
                        MinHeight="44" Padding="0,10"
                        HorizontalAlignment="Stretch" Margin="0,0,0,10">
                    <TextBlock Text="Entrar" Foreground="White"/>
                </Button>
            </StackPanel>
        </md:Card>
    </Grid>
</Grid>
</Window>
