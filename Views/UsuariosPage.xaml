<UserControl x:Class="InventarioAppDesktop.Views.UsuariosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:InventarioAppDesktop.Views">
    <UserControl.Resources>
        <local:RolToVisibilityConverter x:Key="RolToAdminVis"/>
        <local:RolToUsuarioVisibilityConverter x:Key="RolToUsuarioVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel LastChildFill="True" Margin="32,24,32,24">

        <!-- List View -->
        <StackPanel x:Name="PanelLista" DockPanel.Dock="Top">
            <TextBlock Text="Usuarios" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBox Style="{StaticResource SearchBoxStyle}"
                         md:HintAssist.Hint="Buscar usuario..."
                         Text="{Binding UsuariosVM.Filtro, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Margin="16,0,0,0"
                        Click="BtnNueva_Click"
                        Background="{StaticResource InventarioPrimary}"
                        Foreground="White" MinHeight="36" Padding="16,8"
                        Visibility="{Binding EsAdmin, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,6,0"/>
                        <TextBlock Text="NUEVO USUARIO" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <md:Card Padding="0">
                <DataGrid ItemsSource="{Binding UsuariosVM.Usuarios}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="None" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="#F8F8F8"
                          HeadersVisibility="Column" SelectionMode="Single"
                          ColumnHeaderHeight="44" RowHeight="44">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="80">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="ID" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="LblSortId" Text="v" FontWeight="Bold" FontSize="12"
                                               Cursor="Hand" Background="Transparent"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               MouseLeftButtonDown="BtnSortId_Click"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Id}" Margin="12,0"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                    <TextBlock Text="Nombre de Usuario" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="LblSortNombreUsuario" Text="v" FontWeight="Bold" FontSize="12"
                                               Cursor="Hand" Background="Transparent"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               MouseLeftButtonDown="BtnSortNombreUsuario_Click"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NombreUsuario}" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="100">
                            <DataGridTemplateColumn.Header>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="Rol" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="LblSortRol" Text="v" FontWeight="Bold" FontSize="12"
                                               Cursor="Hand" Background="Transparent"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               MouseLeftButtonDown="BtnSortRol_Click"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center">
                                        <Border CornerRadius="4" Padding="12,4"
                                                Background="{StaticResource InventarioPrimary}"
                                                Visibility="{Binding Rol, Converter={StaticResource RolToAdminVis}}">
                                            <TextBlock Text="Admin" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border CornerRadius="4" Padding="12,4"
                                                Background="#5D5D5F"
                                                Visibility="{Binding Rol, Converter={StaticResource RolToUsuarioVis}}">
                                            <TextBlock Text="User" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="120"
                                                Visibility="{Binding DataContext.EsAdmin, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Acciones" FontWeight="Bold" FontSize="13"
                                           HorizontalAlignment="Center"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Click="BtnEditar_Click" Tag="{Binding}" Padding="6">
                                            <md:PackIcon Kind="Pencil" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                                Click="BtnEliminar_Click" Tag="{Binding}" Padding="6"
                                                Foreground="#DC3545">
                                            <md:PackIcon Kind="Delete" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>
            </md:Card>
        </StackPanel>

        <!-- Edit View -->
        <StackPanel x:Name="PanelEditar" DockPanel.Dock="Top" Visibility="Collapsed"
                    MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Text="Editar Usuario" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>

            <md:Card Padding="28,24">
                <StackPanel>
                    <TextBlock Text="Nombre de Usuario" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBox x:Name="TxtNombreEditar" Padding="12,10" FontSize="14" Margin="0,0,0,16"/>

                    <TextBlock Text="Contraseña (dejar vacío para no cambiar)" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <PasswordBox x:Name="TxtPasswordEditar" Padding="12,10" FontSize="14" Margin="0,0,0,16"
                                 md:HintAssist.Hint="Mínimo 8 caracteres"/>

                    <TextBlock Text="Rol" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <ComboBox x:Name="CmbRolEditar" Padding="10,8" FontSize="14" Margin="0,0,0,20">
                        <ComboBoxItem Content="admin"/>
                        <ComboBoxItem Content="usuario"/>
                    </ComboBox>

                    <TextBlock x:Name="LblErrorEditar" Foreground="#DC3545" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="BtnCancelarEditar_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Margin="0,0,8,0" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ArrowLeft" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Volver" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnGuardarEditar_Click"
                                Background="{StaticResource InventarioPrimary}"
                                Foreground="White" Padding="20,8" MinHeight="36">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Check" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Editar" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </md:Card>
        </StackPanel>

        <!-- New View -->
        <StackPanel x:Name="PanelNuevo" DockPanel.Dock="Top" Visibility="Collapsed"
                    MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Text="Nuevo Usuario" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>

            <md:Card Padding="28,24">
                <StackPanel>
                    <TextBlock Text="Nombre de Usuario" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBox x:Name="TxtNombreNuevo" Padding="12,10" FontSize="14" Margin="0,0,0,16"/>

                    <TextBlock Text="Contraseña" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <PasswordBox x:Name="TxtPasswordNuevo" Padding="12,10" FontSize="14" Margin="0,0,0,16"
                                 md:HintAssist.Hint="Mínimo 8 caracteres"/>

                    <TextBlock Text="Rol" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <ComboBox x:Name="CmbRolNuevo" Padding="10,8" FontSize="14" SelectedIndex="1" Margin="0,0,0,20">
                        <ComboBoxItem Content="admin"/>
                        <ComboBoxItem Content="usuario"/>
                    </ComboBox>

                    <TextBlock x:Name="LblErrorNuevo" Foreground="#DC3545" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="BtnCancelarNuevo_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Margin="0,0,8,0" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ArrowLeft" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Volver" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnGuardarNuevo_Click"
                                Background="{StaticResource InventarioPrimary}"
                                Foreground="White" Padding="20,8" MinHeight="36">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Check" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Guardar" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </md:Card>
        </StackPanel>
    </DockPanel>
</UserControl>
