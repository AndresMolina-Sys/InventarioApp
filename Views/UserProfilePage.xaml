<UserControl x:Class="InventarioAppDesktop.Views.UserProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <DockPanel LastChildFill="True" Margin="32,24,32,24">

        <!-- Info View -->
        <StackPanel x:Name="PanelInfo" DockPanel.Dock="Top" MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Text="Mi Perfil" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>

            <md:Card Padding="28,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="Nombre:" FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Width="100"/>
                        <TextBlock x:Name="LblNombre" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,28">
                        <TextBlock Text="Rol:" FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center" Width="100"/>
                        <Border CornerRadius="4" Padding="12,4" VerticalAlignment="Center"
                                Background="{StaticResource InventarioPrimary}">
                            <TextBlock x:Name="LblRol" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Click="BtnCambiarNombre_Click"
                                Style="{StaticResource MaterialDesignFlatButton}" Padding="12,8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Pencil" Width="18" Height="18" Margin="0,0,6,0"
                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                                <TextBlock Text="Cambiar Nombre" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnCambiarPassword_Click"
                                Style="{StaticResource MaterialDesignFlatButton}" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Key" Width="18" Height="18" Margin="0,0,6,0"
                                             Foreground="{DynamicResource MaterialDesignBody}"/>
                                <TextBlock Text="Editar Contraseña" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </md:Card>
        </StackPanel>

        <!-- Change Name View -->
        <StackPanel x:Name="PanelNombre" DockPanel.Dock="Top" Visibility="Collapsed"
                    MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Text="Cambiar Nombre" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>

            <md:Card Padding="28,24">
                <StackPanel>
                    <TextBlock Text="Nuevo nombre de usuario" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <TextBox x:Name="TxtNombreNuevo" Padding="12,10" FontSize="14" Margin="0,0,0,16"/>

                    <TextBlock x:Name="LblErrorNombre" Foreground="#DC3545" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="BtnVolverNombre_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Margin="0,0,8,0" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ArrowLeft" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Volver" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnEditarNombre_Click"
                                Background="{StaticResource InventarioPrimary}"
                                Foreground="White" Padding="20,8" MinHeight="36">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Check" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Editar" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </md:Card>
        </StackPanel>

        <!-- Change Password View -->
        <StackPanel x:Name="PanelPassword" DockPanel.Dock="Top" Visibility="Collapsed"
                    MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Text="Editar Contraseña" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>

            <md:Card Padding="28,24">
                <StackPanel>
                    <TextBlock Text="Contraseña actual" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <PasswordBox x:Name="TxtPasswordActual" Padding="12,10" FontSize="14" Margin="0,0,0,16"
                                 md:HintAssist.Hint="Ingrese su contraseña actual"/>

                    <TextBlock Text="Nueva contraseña" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <PasswordBox x:Name="TxtPasswordNueva" Padding="12,10" FontSize="14" Margin="0,0,0,16"
                                 md:HintAssist.Hint="Mínimo 8 caracteres"/>

                    <TextBlock Text="Confirmar nueva contraseña" FontSize="13" Margin="0,0,0,4"
                               Foreground="{DynamicResource MaterialDesignBody}"/>
                    <PasswordBox x:Name="TxtPasswordConfirmar" Padding="12,10" FontSize="14" Margin="0,0,0,20"
                                 md:HintAssist.Hint="Repita su contraseña"/>

                    <TextBlock x:Name="LblErrorPassword" Foreground="#DC3545" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock x:Name="LblSuccessPassword" Foreground="#28A745" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="BtnVolverPassword_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Margin="0,0,8,0" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ArrowLeft" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Volver" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="BtnConfirmarPassword_Click"
                                Background="{StaticResource InventarioPrimary}"
                                Foreground="White" Padding="20,8" MinHeight="36">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Check" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="Confirmar" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </md:Card>
        </StackPanel>
    </DockPanel>
</UserControl>
