<UserControl x:Class="InventarioAppDesktop.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel LastChildFill="True" Margin="32,24,32,24">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <md:PackIcon Kind="Gauge" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Panel de Control" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Padding="12,8" MinHeight="36" Cursor="Hand" VerticalAlignment="Center"
                    Click="BtnRefrescar_Click"
                    ToolTip="Refrescar: ver los cambios realizados desde otras PCs">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,6,0"/>
                    <TextBlock Text="REFRESCAR" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Stat Cards -->
        <UniformGrid DockPanel.Dock="Top" Rows="1" Margin="0,0,0,24">
            <md:Card Padding="24,20" Margin="0,0,8,0" Background="{StaticResource InventarioPrimary}">
                <StackPanel>
                    <md:PackIcon Kind="PackageVariant" Width="32" Height="32" Foreground="White" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding DashboardVM.TotalArticulos}" FontSize="36" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Artículos" FontSize="13" Foreground="#CCFFFFFF"/>
                </StackPanel>
            </md:Card>
            <md:Card Padding="24,20" Margin="4,0,4,0" Background="{StaticResource InventarioPrimaryDark}">
                <StackPanel>
                    <md:PackIcon Kind="TagMultiple" Width="32" Height="32" Foreground="White" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding DashboardVM.TotalCategorias}" FontSize="36" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Categorías" FontSize="13" Foreground="#CCFFFFFF"/>
                </StackPanel>
            </md:Card>
            <md:Card Padding="24,20" Margin="8,0,0,0" Background="#5F5F61"
                     Visibility="{Binding EsAdmin, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <md:PackIcon Kind="AccountGroup" Width="32" Height="32" Foreground="White" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding DashboardVM.TotalUsuarios}" FontSize="36" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Usuarios" FontSize="13" Foreground="#CCFFFFFF"/>
                </StackPanel>
            </md:Card>
        </UniformGrid>

        <!-- Recent Articles Table -->
        <md:Card DockPanel.Dock="Top" Padding="24" Margin="0,0,0,24">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblPagina" Text="Artículos Recientes" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" Grid.Column="0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnPrev" Click="BtnPrev_Click"
                                Background="Transparent" BorderThickness="0"
                                Padding="6,4" Cursor="Hand"
                                Foreground="{DynamicResource MaterialDesignBody}">
                            <md:PackIcon Kind="ChevronLeft" Width="22" Height="22"/>
                        </Button>
                        <Button x:Name="BtnNext" Click="BtnNext_Click"
                                Background="Transparent" BorderThickness="0"
                                Padding="6,4" Cursor="Hand"
                                Foreground="{DynamicResource MaterialDesignBody}" Margin="2,0,0,0">
                            <md:PackIcon Kind="ChevronRight" Width="22" Height="22"/>
                        </Button>
                    </StackPanel>
                </Grid>
                <DataGrid x:Name="GridRecientes" ItemsSource="{Binding DashboardVM.ArticulosRecientes}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          GridLinesVisibility="None" BorderThickness="0"
                          RowBackground="Transparent" AlternatingRowBackground="#F5F5F5"
                          HeadersVisibility="Column" SelectionMode="Single"
                          ColumnHeaderHeight="44" RowHeight="42"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="False"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Código" FontWeight="Bold" FontSize="13" Margin="12,0,0,0"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Codigo}" FontWeight="Bold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Artículo" FontWeight="Bold" FontSize="13" Margin="12,0,0,0"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Nombre}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Categoría" FontWeight="Bold" FontSize="13" Margin="12,0,0,0"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Categoria.Nombre}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Ubicación" FontWeight="Bold" FontSize="13" Margin="12,0,0,0"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Departamento}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Última Modificación" FontWeight="Bold" FontSize="13" Margin="12,0,0,0"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FechaModificacion, StringFormat='{}{0:dd/MM/yyyy hh:mm tt}'}"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="120">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Acciones" FontWeight="Bold" FontSize="13"
                                           HorizontalAlignment="Center"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                                            Click="BtnVerArticulo_Click" Tag="{Binding}" Padding="6"
                                            HorizontalAlignment="Center">
                                        <md:PackIcon Kind="Eye" Width="18" Height="18"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="Center"
                                                              Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>
                <StackPanel x:Name="LblNoRecientes" Visibility="Collapsed" Margin="0,24,0,0"
                            HorizontalAlignment="Center">
                    <TextBlock Text="No hay artículos registrados" FontSize="14"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </md:Card>

        <!-- Category Distribution Chart -->
        <md:Card DockPanel.Dock="Top" Padding="24" Margin="0,0,0,0">
            <StackPanel>
                <TextBlock Text="Distribución del Inventario" FontSize="18" FontWeight="SemiBold"
                           Margin="0,0,0,20"/>
                <ItemsControl x:Name="ItemsDistribucion" ItemsSource="{Binding DashboardVM.Distribucion}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding Nombre}" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Width="180"/>
                                    <TextBlock Text="{Binding Cantidad}" FontSize="13" FontWeight="Bold"
                                               VerticalAlignment="Center" Width="40" HorizontalAlignment="Right"/>
                                    <TextBlock Text=" artículos" FontSize="13"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource InventarioPrimary}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               HorizontalAlignment="Right" MinWidth="50">
                                        <TextBlock.Text>
                                            <Binding Path="Porcentaje" StringFormat="{}{0:F1}%"/>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <Grid Height="10" Margin="0,0,0,4">
                                    <Grid.Background>
                                        <SolidColorBrush Color="#E8E8E8"/>
                                    </Grid.Background>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Porcentaje, Converter={StaticResource PercentageToStar}}"/>
                                        <ColumnDefinition Width="{Binding PorcentajeInv, Converter={StaticResource PercentageToStar}}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="5" Background="{StaticResource InventarioPrimary}"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="LblNoDistribucion" Text="No hay datos que mostrar" FontSize="14"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           HorizontalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
        </md:Card>
    </DockPanel>
</UserControl>
